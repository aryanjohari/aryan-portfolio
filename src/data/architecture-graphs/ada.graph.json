{
  "version": 1,
  "title": "ADA",
  "summary": "Primary path: chat → orchestrator → allowlisted tools → SQLite. Cron publish and HUD read paths exist but are secondary on this map.",
  "notes": "Chose chat as the portfolio happy path. Cron ingest / graph-lite / daemon→workflow→S3 and HUD→DB are kept as dashed alternate edges so the map stays honest without touring every path.",
  "groups": [
    { "id": "ingress", "label": "Operator surfaces" },
    { "id": "core", "label": "Agent core" },
    { "id": "truth", "label": "Local truth" }
  ],
  "nodes": [
    {
      "id": "chat",
      "label": "ada chat (Entity / Agent / Plan)",
      "kind": "input",
      "groupId": "ingress"
    },
    {
      "id": "cron",
      "label": "cron / systemd",
      "kind": "input",
      "groupId": "ingress"
    },
    {
      "id": "hud",
      "label": "ada hud (read-only)",
      "kind": "input",
      "groupId": "ingress"
    },
    {
      "id": "orch",
      "label": "Orchestrator (Gemini tools)",
      "kind": "process",
      "groupId": "core"
    },
    {
      "id": "tools",
      "label": "Tool executor (allowlist)",
      "kind": "process",
      "groupId": "core"
    },
    {
      "id": "daemon",
      "label": "ada daemon (goals + workflows)",
      "kind": "process",
      "groupId": "core"
    },
    {
      "id": "db",
      "label": "state.db (SQLite)",
      "kind": "store",
      "groupId": "truth",
      "shape": "cylinder"
    },
    {
      "id": "mem",
      "label": "memory/*.md",
      "kind": "store",
      "groupId": "truth"
    },
    {
      "id": "workflow",
      "label": "Publish workflows → S3",
      "kind": "process"
    },
    {
      "id": "out",
      "label": "S3 page.json + manifest",
      "kind": "output"
    }
  ],
  "edges": [
    { "from": "chat", "to": "orch" },
    { "from": "orch", "to": "tools" },
    { "from": "tools", "to": "db" },
    { "from": "orch", "to": "mem" },
    { "from": "cron", "to": "daemon", "style": "dashed" },
    { "from": "daemon", "to": "orch", "style": "dashed" },
    { "from": "daemon", "to": "workflow", "style": "dashed" },
    { "from": "workflow", "to": "out", "style": "dashed" },
    { "from": "hud", "to": "db", "style": "dashed" }
  ],
  "tour": ["chat", "orch", "tools", "db", "mem"]
}
