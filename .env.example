# Google Gemini API key for the Ask box (server-side only). Also used at build time to embed the content.
# Without it the Ask box is off and the build still works (keyword search only).
# Get one at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_key_here

# Optional model overrides (defaults in src/lib/ask/gemini.ts)
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
