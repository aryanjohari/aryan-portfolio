# Optional: GitHub personal access token for fetching portfolio.yaml from private repos.
# Public repos work without a token. Never commit real tokens.
# GITHUB_TOKEN=ghp_xxxxxxxx

# Skip build-time fetch and use mock data instead (dev convenience).
# PORTFOLIO_FETCH_SKIP=true

# Google Gemini API key for the portfolio guide (server-side only).
# Get one at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_key_here
